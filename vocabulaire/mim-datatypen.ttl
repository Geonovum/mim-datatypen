   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Gegevenstype voor posities in tijd met een temporele resolutie van een jaar."@nl ;
   skos:scopeNote "4-cijferig jaar uitgedrukt in yyyy conform ISO 8601.\nZie ook ISO/IEC 11404"@nl ;
