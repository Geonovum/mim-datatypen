.

# Construct: MIM datatypen::Integer (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/Integer>
   a skos:Concept ;
   skos:prefLabel "Integer"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2025-09-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Wiskundig gegevenstype bestaand uit exacte geheel getal."@nl ;
   skos:scopeNote "Zie [iso-19103] (subtype van ISO Number). Vrij vertaald: geheel getal, lengte is minimaal 1 en maximale lengte is onbepaald, zonder voorloopnullen. Opmerking: t.a.v. positieve en negatieve getalen en + en - tekens: bijvoorbeeld -2,0 Het (formeel) patroon geeft aan of een + en/of - teken gebruikt mag worden in het gegeven."@nl ;
   dct:source "ISO 19103" ;
.

# Construct: MIM datatypen::URI (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/URI>
   a skos:Concept ;
   skos:prefLabel "URI"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2025-09-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Character string die conformeert aan de syntax gedefinieerd in RFC 3986."@nl ;
   skos:scopeNote "Unieke identificatie op internet conform RFC3986 en de URI-strategie Linked Open Data. Gestandaardiseerde manier om op het internet dingen (pagina's met informatie, objecten, datasets) uniek te identificeren."@nl ;
   dct:source "ISO 19103" ;
.

# Construct: MIM datatypen::Decimal (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/Decimal>
   a skos:Concept ;
   skos:prefLabel "Decimal"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2025-09-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Een gegevenstype waarin het getal een exacte waarde vertegenwoordigt, als een eindige weergave van een decimaal getal. "@nl ;
   skos:scopeNote "Zie ook ISO/IEC 11404.\nAangezien veel valuta's decimaal zijn, hebben deze weergaven de voorkeur bij het omgaan met dergelijke waarden.\nOpmerking 1: Dit verschilt van real, want real is een geschatte waarde en Decimal is exact. \nOpmerking 2: t.a.v. positieve en negatieve getalen en + en - tekens: zie Integer."@nl ;
   dct:source "ISO 19103" ;
.

# Construct: MIM datatypen::Boolean (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/Boolean>
   a skos:Concept ;
   skos:prefLabel "Boolean"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2026-07-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Wiskundig gegevenstype gerelateerd aan twee-waarde logica."@nl ;
   skos:scopeNote "Indicatie met mogelijke waarden True, false, 1 of 0. True en 1 hebben een identieke betekenis: Ja. False en 0 hebben een identieke betekenis: Nee."@nl ;
   dct:source "ISO 19103" ;
.

# Construct: MIM datatypen::Day (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/Day>
   a skos:Concept ;
