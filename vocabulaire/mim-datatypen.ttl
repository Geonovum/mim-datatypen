# Construct: MIM datatypen::UUID (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/UUID>
   a skos:Concept ;
   skos:prefLabel "UUID"@nl ;
   dct:created "2025-09-02"^^xsd:date ;
   dct:modified "2026-07-01"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Een 128-bit identificator die unique is in ruimte en tijd binnen de ruimte van alle UUID's. De waarden conformeren aan ISO/IEC 9834-8."@nl ;
