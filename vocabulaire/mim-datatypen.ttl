   skos:definition "Een hoeveelheidswaarde die een meetresultaat vertegenwoordigt."@nl ;
   dct:source "ISO19103" ;
.

# Construct: MIM datatypen::DateTime (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/mim-datatypen/id/concept/DateTime>
   a skos:Concept ;
   skos:prefLabel "DateTime"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2026-07-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Gegevenstype voor posities in tijd met een temporele resolutie van een deel van een seconde."@nl ;
   skos:scopeNote "yyyy-mm-ddThh:mm:ss conform ISO 8601.\nZie ook ISO/IEC 11404"@nl ;
