   skos:inScheme <http://definities.geostandaarden.nl/mim-datatypen/id/conceptscheme/MIM> ;
   skos:definition "Een kalenderdag binnen de Gregoriaanse kalender, weergegeven als onderdeel van een datum."@nl ;
   skos:scopeNote "2-cijferige dag uitgedrukt in dd conform ISO 8601."@nl ;
   dct:source "ISO 19103" ;
.

